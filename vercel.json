{
    "builds": [
        {
            "src": "api/chat.js",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/chat",
            "destination": "api/chat.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}